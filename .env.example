# --- Приложение ---
PORT=3000
NODE_ENV=development

# --- База данных ---
# Вариант 1 (Docker + PostgreSQL): раскомментируй строку ниже
# DATABASE_URL=postgres://shawarma:shawarma@localhost:5432/shawarma
# Вариант 2 (локально без Docker): ничего не задавай — включится SQLite

# Файл SQLite (используется, если DATABASE_URL не задан)
SQLITE_FILE=./data/shawarma.db

# --- Безопасность ---
JWT_SECRET=dev-secret-change-me-in-production
JWT_TTL_SECONDS=86400
