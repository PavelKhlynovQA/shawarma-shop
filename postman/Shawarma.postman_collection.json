{
  "info": {
    "name": "Шаурма-Мастер API",
    "description": "Коллекция запросов для ручного и полуавтоматического тестирования",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "publicId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01. Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "02. Menu",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/menu",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "menu"
          ]
        }
      }
    },
    {
      "name": "03. Login (admin) — сохраняет токен",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('token', json.token);",
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@shawarma.ru\",\n  \"password\": \"Admin123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "04. Promo validate",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"SHAWARMA10\",\n  \"subtotal\": 1000\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/promo/validate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "promo",
            "validate"
          ]
        }
      }
    },
    {
      "name": "05. Create order — сохраняет publicId",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('publicId', json.order.publicId);",
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('total рассчитан', () => pm.expect(json.order.total).to.be.a('number'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Иван Тестов\",\n  \"phone\": \"+7 900 123-45-67\",\n  \"deliveryType\": \"delivery\",\n  \"address\": \"Волгоград, ул. Мира, 15\",\n  \"promoCode\": \"SHAWARMA10\",\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2,\n      \"extraIds\": [\n        1,\n        2\n      ]\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        }
      }
    },
    {
      "name": "06. Track order",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{publicId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "{{publicId}}"
          ]
        }
      }
    },
    {
      "name": "07. Admin orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/orders?limit=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "orders"
          ]
        }
      }
    },
    {
      "name": "08. Change status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CONFIRMED\",\n  \"note\": \"Приняли в работу\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/orders/1/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "orders",
            "1",
            "status"
          ]
        }
      }
    },
    {
      "name": "09. Admin stats",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/stats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "stats"
          ]
        }
      }
    },
    {
      "name": "10. Negative: пустая корзина",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Тест\",\n  \"phone\": \"+79001234567\",\n  \"deliveryType\": \"pickup\",\n  \"items\": []\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        }
      }
    }
  ]
}