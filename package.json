{
  "name": "shawarma-shop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Учебный интернет-магазин шаурмы — полигон для функционального и автоматизированного тестирования",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed-run.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:api": "node --test \"tests/api.test.js\"",
    "test:smoke": "node --test \"tests/smoke.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test --config=playwright.visual.config.js",
    "test:visual:update": "playwright test --config=playwright.visual.config.js --update-snapshots",
    "test:all": "npm test && npm run test:e2e && npm run test:visual",
    "report": "playwright show-report",
    "allure:generate": "node scripts/allure-report.mjs",
    "allure:open": "node scripts/allure-open.mjs",
    "check:docker": "node tests/docker-smoke.mjs",
    "test:journey": "playwright test tests/e2e/journey.spec.js",
    "demo:journey": "node scripts/journey-demo.mjs",
    "test:no-isolation": "node --test --test-isolation=none \"tests/**/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0"
  },
  "engines": {
    "node": ">=24"
  }
}
